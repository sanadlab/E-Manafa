# buffer 0: power rails and battery counters. buffer 1: ftrace.
# ftrace is high volume, so it has its own buffer and cannot push out the power data.
buffers: {
    size_kb: 4096
    fill_policy: DISCARD
}

buffers: {
    size_kb: 61440
    fill_policy: DISCARD
}

data_sources: {
    config {
        name: "android.power"
        target_buffer: 0
        android_power_config {
            battery_poll_ms: 250
            battery_counters: BATTERY_COUNTER_UNSPECIFIED
            battery_counters: BATTERY_COUNTER_CHARGE
            battery_counters: BATTERY_COUNTER_CAPACITY_PERCENT
            battery_counters: BATTERY_COUNTER_CURRENT
            battery_counters: BATTERY_COUNTER_CURRENT_AVG
            collect_power_rails: true
            # energy consumers of the PowerStats HAL (Android 12 and later). used when the device has no rails
            collect_energy_estimation_breakdown: true
        }
    }
}

data_sources: {
    config {
        name: "linux.ftrace"
        target_buffer: 1
        ftrace_config {
            ftrace_events: "sched/sched_switch"
            ftrace_events: "power/cpu_frequency"
            ftrace_events: "power/cpu_idle"
            # a new app process has the name of zygote until it is renamed
            ftrace_events: "task/task_newtask"
            ftrace_events: "task/task_rename"
        }
    }
}

# names of the processes and the CPU clusters: the scheduler events and the CPU rails
# then give the energy of each process
data_sources: {
    config {
        name: "linux.process_stats"
        target_buffer: 1
        process_stats_config {
            scan_all_processes_on_start: true
        }
    }
}

data_sources: {
    config {
        name: "linux.system_info"
        target_buffer: 1
    }
}

# no duration_ms: the trace runs until the profiler stops it
